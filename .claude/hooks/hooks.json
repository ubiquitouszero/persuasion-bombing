{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(ts|tsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/scripts/check-typescript.js"
          }
        ],
        "description": "TypeScript check after editing .ts/.tsx files"
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(ts|tsx|js|jsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/scripts/warn-console-log.js"
          }
        ],
        "description": "Warn about console.log statements after edits"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/guard-destructive.sh",
            "timeout": 10
          }
        ],
        "description": "Block destructive git/shell commands (force-push, reset --hard, rm -rf)"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/protect-sensitive-files.sh",
            "timeout": 10
          }
        ],
        "description": "Block edits to .env, credentials, and key files"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts/subagent-auto-approve.sh",
            "timeout": 10
          }
        ],
        "description": "Auto-approve safe tool calls for subagents (they crash on permission prompts)"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/scripts/suggest-compaction.js"
          }
        ],
        "description": "Suggest compaction at logical intervals to prevent context degradation"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/scripts/check-uncommitted.js"
          }
        ],
        "description": "Remind about uncommitted changes at session end"
      }
    ]
  }
}
